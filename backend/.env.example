DATABASE_URL=sqlite:///./diagram_to_solution.db
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads

# --- Agent Model Shifter Configuration ---
MAX_MODEL_SWITCHES=5
MODEL_REQUEST_TIMEOUT_SECONDS=30.0

# Two-level Provider & Model Chains (comma-separated list)
LLM_PROVIDER_CHAIN=gemini,grok,openai

GEMINI_MODEL_CHAIN=gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-pro-preview
GROK_MODEL_CHAIN=grok-2-latest,grok-beta
OPENAI_MODEL_CHAIN=gpt-4o,gpt-4o-mini

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
